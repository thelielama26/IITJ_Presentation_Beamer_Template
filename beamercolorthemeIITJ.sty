\ProvidesPackage{beamercolorthemeIITJ}
\mode<presentation>  % Invoke presentation mode

% Colors sampled from the official IIT Jodhpur Logo
\definecolor{Primary}{HTML}{2B308B}    % IITJ Deep Indigo/Blue (Primary Theme)
\definecolor{Secondary}{HTML}{F2F3F7}  % Off-White/Light Gray (Sidebar/Card Background)
\definecolor{Tertiary}{HTML}{1A1D54}   % Dark Midnight Blue (Headers/Dark Highlights)
\definecolor{IITJOrange}{HTML}{F39200} % IITJ Accent Orange/Gold

\definecolor{Teal}{HTML}{008080}       % Soft Teal (Example Blocks)
\definecolor{Red}{HTML}{B22222}        % Alert Red
\definecolor{DarkText}{HTML}{222222}   % Off-Black for comfortable reading

\definecolor{White}{RGB}{255,255,255}
\definecolor{Black}{RGB}{0,0,0}

% Sidebar and Section Colors
\setbeamercolor{sidebar}{bg=Secondary}
\setbeamercolor{section in sidebar}{fg=Primary}

% Title, Author, and Date Colors
\setbeamercolor{titlelike}{fg=Primary}
\setbeamercolor{author}{fg=DarkText}
\setbeamercolor{date}{fg=DarkText}
\setbeamercolor{institute}{fg=DarkText}

% Frame Title and Subtitle Colors
\setbeamercolor{frametitle}{fg=Primary}
\setbeamercolor{framesubtitle}{fg=IITJOrange}

% Text Colors
\setbeamercolor{normal text}{fg=DarkText}
\setbeamercolor{structure}{fg=Primary}
\setbeamercolor{alerted text}{fg=Red}
\setbeamercolor{example text}{fg=Teal}

% Block Title Colors
\setbeamercolor{block title}{use=structure,fg=White,bg=Primary}
\setbeamercolor{block title alerted}{use=alerted text,fg=White,bg=Red}
\setbeamercolor{block title example}{use=example text,fg=White,bg=Teal}

% Block Body Colors
\setbeamercolor{block body}{bg=Secondary,fg=DarkText}
\setbeamercolor{block body alerted}{bg=Secondary,fg=DarkText}
\setbeamercolor{block body example}{bg=Secondary,fg=DarkText}

% Table of Contents Section Colors
\setbeamercolor{section in toc}{fg=Primary,bg=White}

% Navigation Symbols Color
\setbeamercolor{navigation symbols}{fg=Primary}

% Beamer Color Box and Footer Colors
\setbeamercolor{footline}{bg=Secondary}
\setbeamercolor{title in head/foot}{fg=Primary}
\setbeamercolor{author in head/foot}{fg=IITJOrange}

\mode<all>